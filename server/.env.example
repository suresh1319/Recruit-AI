PORT=5001
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/recruit-ai"

# Public URLs used in generated resume and interview links.
PUBLIC_API_URL="https://your-api-domain.com"
CLIENT_URL="https://your-frontend-domain.com"

# AI and speech services.
GEMINI_API_KEY="your-google-genai-key"
GEMINI_TEXT_MODEL="gemini-2.5-flash"
DEEPGRAM_API_KEY="your-deepgram-key"
MURF_API_KEY="your-murf-key"

# Email notifications.
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-app-password"
