# Neon PostgreSQL Database URL
# Go to Neon Console -> Settings -> Connection Details
DATABASE_URL="postgresql://user:password@hostname.neon.tech/neondb?sslmode=require"

# Note: Direct connection from React using VITE_ is unsafe for production.
